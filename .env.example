# Copy this file to .env before starting the application.
# Local demo credentials only; replace them for your own environment.
API_KEY=local-test-api-key
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
POSTGRES_TEST_DB=payments_test
RABBITMQ_DEFAULT_USER=payments
RABBITMQ_DEFAULT_PASS=payments

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/
TEST_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_TEST_DB}
TEST_RABBITMQ_URL=${RABBITMQ_URL}

RETRY_BASE_SECONDS=2
OUTBOX_POLL_SECONDS=0.5
WEBHOOK_TIMEOUT_SECONDS=10
PUBLISH_TIMEOUT_SECONDS=10
DATABASE_REQUEUE_DELAY_SECONDS=1

API_BIND_HOST=127.0.0.1
API_PORT=8000
WEBHOOK_PORT=8080
RABBITMQ_MANAGEMENT_PORT=15672
SMOKE_API_URL=http://localhost:${API_PORT}
SMOKE_WEBHOOK_URL=http://localhost:${WEBHOOK_PORT}
SMOKE_RABBIT_URL=http://localhost:${RABBITMQ_MANAGEMENT_PORT}
SMOKE_CALLBACK_URL=http://webhook:8080
